# Supabase project credentials (required — get from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Apps Script endpoint (dùng cho form tư vấn)
VITE_APPS_SCRIPT_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
